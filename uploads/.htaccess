# Disable PHP script execution inside the uploads directory.
# Uploaded files may only be served as static content.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

# Serve images with their real static types only.
php_flag engine off
Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
